[Unit]
Description=PayPal Delight AI Sandbox backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paypal-delight
Group=paypal-delight
WorkingDirectory=/var/www/paypal-delight-ai/current
EnvironmentFile=/etc/paypal-delight-ai/runtime.env
ExecStart=/usr/bin/node /var/www/paypal-delight-ai/current/server/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/paypal-delight-ai/shared
MemoryMax=768M

[Install]
WantedBy=multi-user.target
