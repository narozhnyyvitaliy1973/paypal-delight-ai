# Local backend configuration. Copy this file to .env in the repository root.
# Existing process environment variables take precedence over .env.
HOST=127.0.0.1
PORT=8003
APP_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated exact origins; no wildcard or trailing slash.
# APP_ADDITIONAL_ORIGINS=https://shop.museumpuzzles.com
DATABASE_PATH=data/delight.sqlite

# Sandbox only. Copy credentials from your Sandbox Business REST app.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Leave both credentials empty to browse the store with checkout disabled.
# Production: HTTPS APP_ORIGIN and an absolute DATABASE_PATH outside release directories.
# Never put server secrets in VITE_* variables: those are public in the browser.

# Default remains a local demo: no external AI requests.
AI_PROVIDER=mock
AI_ENABLED=false

# Enable cloudflare only after separate owner approval of the first real generation.
# Server only. No AI Gateway or alternate/paid model fallback is implemented.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
AI_TIMEOUT_MS=240000
AI_MAX_CONCURRENT=2
AI_DAILY_REQUEST_LIMIT=50
AI_SESSION_DAILY_REQUEST_LIMIT=50
# Conservative local estimated Neurons, including failed/uncertain requests.
# Does not account for Playground/other apps. Keep the account on Workers Free.
AI_DAILY_NEURON_LIMIT=8000

# Set only after confirming Workers Free in the account (does not change billing).
CLOUDFLARE_ACCOUNT_PLAN=
# Closed test studio; a proxy token is installed by the approved deployment.
AI_LAB_ENABLED=false
AI_LAB_PROXY_TOKEN=
