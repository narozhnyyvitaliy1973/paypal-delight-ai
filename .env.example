# Local backend configuration. Copy this file to .env in the repository root.
# Existing process environment variables take precedence over .env.
HOST=127.0.0.1
PORT=8003
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=data/delight.sqlite

# Sandbox only. Copy credentials from your Sandbox Business REST app.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Leave both credentials empty to browse the store with checkout disabled.
# Production: HTTPS APP_ORIGIN and an absolute DATABASE_PATH outside release directories.
# Never put server secrets in VITE_* variables: those are public in the browser.
